  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "^0.22.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260101.0",
    "typescript": "^5.6.3",
    "wrangler": "^4.8.0"
  }
}
